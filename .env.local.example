# Proyecto Supabase: Tablero Online (bpitialkrbfgwsriiips · us-east-2)
# Copiar a .env.local. NUNCA commitear .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://bpitialkrbfgwsriiips.supabase.co

# Clave publicable: segura en el navegador. Todo el acceso lo gobierna RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_f97HMDIjEBldzntndGAsHQ_PFUefHfl

# Service role: SOLO en servidor. Se salta RLS por completo.
# Se obtiene en el dashboard de Supabase -> Project Settings -> API Keys.
# Necesaria para el import CSV/XLSX (que usa `set local app.importing`) y para
# el alta de miembros con rol.
SUPABASE_SERVICE_ROLE_KEY=

# --- Registro propio -------------------------------------------------------
# Codigo compartido para darse de alta. Si esta vacio, cualquiera con la URL
# puede registrarse como miembro. La herramienta es interna: conviene ponerlo.
REGISTRO_CODIGO=

# Opcional: limita el registro a un dominio de correo (sin la arroba).
REGISTRO_DOMINIO=
