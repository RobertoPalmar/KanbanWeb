# Proyecto Supabase: Tablero Online (bpitialkrbfgwsriiips · us-east-2)
# Copiar a .env.local. NUNCA commitear .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://bpitialkrbfgwsriiips.supabase.co

# Clave publicable: segura en el navegador. Todo el acceso lo gobierna RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_f97HMDIjEBldzntndGAsHQ_PFUefHfl

# Service role: SOLO en servidor. Se salta RLS por completo.
# Se obtiene en el dashboard de Supabase -> Project Settings -> API Keys.
# Necesaria para el import CSV/XLSX (que usa `set local app.importing`) y para
# el alta de miembros con rol.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publica del sitio -------------------------------------------------
# OBLIGATORIA para invitar por correo. El enlace del correo se abre en otro
# dispositivo, asi que tiene que ser absoluto: con esto se arma el `redirectTo`
# que apunta a /auth/callback. Sin ella la invitacion se rechaza antes de
# escribir nada, con un mensaje que lo dice.
#
# En local:      http://localhost:3000
# En produccion: la URL del despliegue (en Vercel se deduce sola de
#                VERCEL_PROJECT_PRODUCTION_URL, asi que ahi es opcional).
#
# ADEMAS hay que dar de alta esa URL en el panel de Supabase:
#   Authentication > URL Configuration
#     · Site URL       -> la misma URL base
#     · Redirect URLs  -> http://localhost:3000/** (y la de produccion)
# Si no esta dada de alta, Supabase rechaza el envio del correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Registro propio -------------------------------------------------------
# Codigo compartido para darse de alta. Si esta vacio, cualquiera con la URL
# puede registrarse como miembro. La herramienta es interna: conviene ponerlo.
REGISTRO_CODIGO=

# Opcional: limita el registro a un dominio de correo (sin la arroba).
REGISTRO_DOMINIO=
